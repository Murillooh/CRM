// schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
// CORE (TENANT & AUTH)
// -----------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  emailSignature String?  @db.Text @map("email_signature") // Assinatura usada no compose de e-mail (Módulo 5/Email Sync)

  memberships   Membership[]
  sessions      Session[]
  accounts      Account[]
  activities    Activity[]
  emailAccounts EmailAccount[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String    @map("user_id")
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  accessToken           String?   @map("access_token") @db.Text
  refreshToken          String?   @map("refresh_token") @db.Text
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?   @db.Text // Argon2id hash stored here
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("verifications")
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logoUrl   String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships   Membership[]
  companies     Company[]
  contacts      Contact[]
  pipelines     Pipeline[]
  pipelineStages PipelineStage[]
  deals         Deal[]
  tasks         Task[]
  activities    Activity[]
  notes         Note[]
  tags          Tag[]
  workflows     Workflow[]
  emailAccounts EmailAccount[]

  @@map("workspaces")
}

enum Role {
  OWNER
  ADMIN
  MANAGER
  SALES_REP
  VIEWER
}

model Membership {
  id          String    @id @default(cuid())
  role        Role      @default(VIEWER)
  region      String?   // Território do rep, usado pelo roteamento de leads (Módulo 8)

  userId      String    @map("user_id")
  workspaceId String    @map("workspace_id")

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@map("memberships")
}

// -----------------------------------------------------------------------------
// CRM ENTITIES
// -----------------------------------------------------------------------------

model Company {
  id            String    @id @default(cuid())
  name          String
  domain        String?
  industry      String?
  employeeCount Int?      @map("employee_count") // Porte, usado pelo roteamento de leads (Módulo 8)
  region        String?   // Território, usado pelo roteamento de leads (Módulo 8)
  ownerId       String?   @map("owner_id") // ID do User responsável (mesmo padrão de Deal.ownerId)

  workspaceId String    @map("workspace_id")
  
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at") // Soft delete

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contacts    Contact[]
  deals       Deal[]
  tasks       Task[]
  activities  Activity[]
  notes       Note[]
  tags        Tag[]     @relation("CompanyTags")

  @@index([workspaceId, name])
  @@map("companies")
}

model Contact {
  id          String    @id @default(cuid())
  name        String
  email       String?
  phone       String?
  jobTitle    String?   @map("job_title")
  ownerId     String?   @map("owner_id") // ID do User responsável (mesmo padrão de Deal.ownerId)

  workspaceId String    @map("workspace_id")
  companyId   String?   @map("company_id")

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at") // Soft delete

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  company     Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  deals       Deal[]
  tasks       Task[]
  activities  Activity[]
  notes       Note[]
  tags        Tag[]     @relation("ContactTags")
  workflowEnrollments WorkflowEnrollment[]

  @@index([workspaceId, companyId])
  @@index([workspaceId, email])
  @@map("contacts")
}

// -----------------------------------------------------------------------------
// PIPELINE & DEALS
// -----------------------------------------------------------------------------

model Pipeline {
  id          String    @id @default(cuid())
  name        String
  
  workspaceId String    @map("workspace_id")
  
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  stages      PipelineStage[]
  deals       Deal[]

  @@index([workspaceId])
  @@map("pipelines")
}

model PipelineStage {
  id          String    @id @default(cuid())
  name        String
  order       Int
  
  workspaceId String    @map("workspace_id")
  pipelineId  String    @map("pipeline_id")

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  pipeline    Pipeline  @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  deals       Deal[]

  @@index([workspaceId, pipelineId, order])
  @@map("pipeline_stages")
}

enum DealStatus {
  OPEN
  WON
  LOST
}

enum DealApprovalStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

model Deal {
  id               String     @id @default(cuid())
  title            String
  value            Decimal?   @db.Decimal(12, 2)
  currency         String     @default("BRL")
  status           DealStatus @default(OPEN)
  probability      Int?       @default(0) // 0 to 100
  expectedCloseDate DateTime? @map("expected_close_date")
  discountPercent  Int?       @map("discount_percent") // Declarado ao marcar como Ganho (Módulo 8: aprovação condicional)
  approvalStatus   DealApprovalStatus @default(NONE) @map("approval_status")
  approvedById     String?    @map("approved_by_id")
  approvedAt       DateTime?  @map("approved_at")
  closedAt         DateTime?  @map("closed_at") // Carimbado em markDealWon/markDealLost — base do ciclo médio de venda (Relatórios)

  workspaceId      String     @map("workspace_id")
  pipelineId       String     @map("pipeline_id")
  stageId          String     @map("stage_id")
  companyId        String?    @map("company_id")
  contactId        String?    @map("contact_id")
  ownerId          String?    @map("owner_id") // ID of the User in the workspace

  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")
  stageEnteredAt   DateTime   @default(now()) @map("stage_entered_at") // Carimbado toda vez que stageId muda (Módulo 8: alerta de deal parado)
  deletedAt        DateTime?  @map("deleted_at") // Soft delete

  workspace        Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  pipeline         Pipeline   @relation(fields: [pipelineId], references: [id], onDelete: Restrict)
  stage            PipelineStage @relation(fields: [stageId], references: [id], onDelete: Restrict)
  company          Company?   @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact          Contact?   @relation(fields: [contactId], references: [id], onDelete: SetNull)
  
  tasks            Task[]
  activities       Activity[]
  notes            Note[]
  tags             Tag[]      @relation("DealTags")

  @@index([workspaceId, pipelineId, stageId])
  @@index([workspaceId, companyId])
  @@index([workspaceId, contactId])
  @@map("deals")
}

// -----------------------------------------------------------------------------
// PRODUCTIVITY (TASKS, ACTIVITIES, NOTES)
// -----------------------------------------------------------------------------

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

model Task {
  id          String     @id @default(cuid())
  title       String
  description String?    @db.Text
  dueDate     DateTime?  @map("due_date")
  status      TaskStatus @default(TODO)
  
  workspaceId String     @map("workspace_id")
  assigneeId  String?    @map("assignee_id") // ID do usuário
  createdByActionId String? @map("created_by_action_id") // WorkflowAction.id, quando gerada por automação (idempotência)

  // Relacionamentos Opcionais
  dealId      String?    @map("deal_id")
  companyId   String?    @map("company_id")
  contactId   String?    @map("contact_id")

  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  deal        Deal?      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  company     Company?   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact     Contact?   @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([createdByActionId, dealId])
  @@index([workspaceId, assigneeId, status])
  @@index([workspaceId, dueDate])
  @@map("tasks")
}

enum ActivityType {
  EMAIL
  CALL
  MEETING
  NOTE_ADDED
  STAGE_CHANGED
  SYSTEM_LOG
}

model Activity {
  id          String       @id @default(cuid())
  type        ActivityType
  description String?      @db.Text
  metadata    Json?        // Campos dinâmicos (ex: duração de chamada, id de email)
  externalId  String?      @map("external_id") // ID da mensagem no provedor (Gmail), usado pra dedup do Email Sync

  workspaceId String       @map("workspace_id")
  performerId String?      @map("performer_id") // ID do usuário que fez a ação

  // Relacionamentos Opcionais
  dealId      String?      @map("deal_id")
  companyId   String?      @map("company_id")
  contactId   String?      @map("contact_id")

  createdAt   DateTime     @default(now()) @map("created_at")
  performer   User?        @relation(fields: [performerId], references: [id], onDelete: SetNull)

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  deal        Deal?        @relation(fields: [dealId], references: [id], onDelete: Cascade)
  company     Company?     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact     Contact?     @relation(fields: [contactId], references: [id], onDelete: Cascade)

  // Índices compostos por Workspace + Entidade, vitais para o Timeline view do CRM
  @@index([workspaceId, dealId, createdAt(sort: Desc)])
  @@index([workspaceId, contactId, createdAt(sort: Desc)])
  @@index([workspaceId, companyId, createdAt(sort: Desc)])
  // Dedup do Email Sync: mesma mensagem do provedor nunca vira 2 Activities no mesmo workspace
  @@unique([workspaceId, externalId])
  @@map("activities")
}

// -----------------------------------------------------------------------------
// EMAIL SYNC (Módulo 5 — timeline) — sincronização Gmail via OAuth2
// -----------------------------------------------------------------------------

enum EmailProvider {
  GMAIL
}

enum EmailSyncStatus {
  CONNECTED
  ERROR
  DISCONNECTED
}

model EmailAccount {
  id               String          @id @default(cuid())
  provider         EmailProvider   @default(GMAIL)
  emailAddress     String
  status           EmailSyncStatus @default(CONNECTED)
  lastError        String?         @db.Text

  // Tokens OAuth criptografados em repouso (AES-256-GCM, ver token-crypto.ts). Nunca em texto puro.
  accessTokenEnc   String          @db.Text @map("access_token_enc")
  refreshTokenEnc  String          @db.Text @map("refresh_token_enc")

  historyId        String?         @map("history_id") // Cursor de sync incremental do Gmail
  lastSyncAt       DateTime?       @map("last_sync_at")
  nextSyncAt       DateTime        @default(now()) @map("next_sync_at") // Scanner de cron só processa quem já venceu
  backoffUntil     DateTime?       @map("backoff_until") // Backoff por rate limit, isolado por conta
  backoffAttempts  Int             @default(0) @map("backoff_attempts") // Zera a cada sync com sucesso

  workspaceId      String          @map("workspace_id")
  connectedById    String          @map("connected_by_id") // User dono da caixa conectada

  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  workspace        Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connectedBy      User            @relation(fields: [connectedById], references: [id], onDelete: Cascade)

  @@unique([workspaceId, emailAddress])
  @@index([status, nextSyncAt])
  @@map("email_accounts")
}

model Note {
  id          String    @id @default(cuid())
  content     String    @db.Text
  
  workspaceId String    @map("workspace_id")
  authorId    String    @map("author_id") // Relacionamento com Usuário omitido para simplicidade de query
  
  dealId      String?   @map("deal_id")
  companyId   String?   @map("company_id")
  contactId   String?   @map("contact_id")

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  deal        Deal?     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  company     Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact     Contact?  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([workspaceId, dealId, createdAt(sort: Desc)])
  @@index([workspaceId, contactId, createdAt(sort: Desc)])
  @@map("notes")
}

// -----------------------------------------------------------------------------
// TAGS & METADATA
// -----------------------------------------------------------------------------

model Tag {
  id          String    @id @default(cuid())
  name        String
  color       String    @default("#E2E8F0") // hex code padrão (tailwind slate-200)
  
  workspaceId String    @map("workspace_id")
  
  createdAt   DateTime  @default(now()) @map("created_at")

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  
  // Relacionamentos Implícitos Many-to-Many no Prisma
  companies   Company[] @relation("CompanyTags")
  contacts    Contact[] @relation("ContactTags")
  deals       Deal[]    @relation("DealTags")

  // Não pode haver 2 tags com mesmo nome no mesmo workspace
  @@unique([workspaceId, name])
  @@map("tags")
}

// -----------------------------------------------------------------------------
// MODULE 8: AUTOMATION & WORKFLOWS
// -----------------------------------------------------------------------------

enum TriggerType {
  DEAL_STAGE_CHANGED
  SCHEDULE_DAILY
  CONTACT_CREATED
  COMPANY_CREATED
  DEAL_STALLED // Disparado pelo scanner de cron (/api/cron/tick), um evento por deal parado
  DEAL_WON_ATTEMPTED // Disparado por markDealWon antes de confirmar o status (guarda síncrona)
}

enum ActionType {
  CREATE_TASK
  NOTIFY_OWNER
  ASSIGN_OWNER
  NOTIFY_MANAGER
  FLAG_DUPLICATE
  ENROLL_IN_SEQUENCE
  REQUIRE_APPROVAL
}

enum EnrollmentStatus {
  ACTIVE
  STOPPED
  COMPLETED
}

model WorkflowEnrollment {
  id               String           @id @default(cuid())
  step             Int              @default(0)
  status           EnrollmentStatus @default(ACTIVE)
  nextSendAt       DateTime         @map("next_send_at")
  enrolledAtStageId String          @map("enrolled_at_stage_id") // Snapshot do estágio no momento do enroll; se o deal sair dali, para a sequência

  workflowId       String           @map("workflow_id")
  contactId        String           @map("contact_id")
  dealId           String?          @map("deal_id")

  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  workflow         Workflow         @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  contact          Contact          @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([status, nextSendAt])
  @@index([workflowId, contactId, status])
  @@map("workflow_enrollments")
}

model Workflow {
  id          String   @id @default(cuid())
  name        String
  isActive    Boolean  @default(true)
  triggerType TriggerType
  condition   Json?
  state       Json?    // Bookkeeping do engine (ex: cursor de round-robin). Não é config de usuário.

  workspaceId String   @map("workspace_id")
  
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actions     WorkflowAction[]
  logs        WorkflowLog[]
  enrollments WorkflowEnrollment[]

  @@index([workspaceId, triggerType, isActive])
  @@map("workflows")
}

model WorkflowAction {
  id          String     @id @default(cuid())
  actionType  ActionType
  payload     Json       
  order       Int        @default(0)
  
  workflowId  String     @map("workflow_id")
  workflow    Workflow   @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId])
  @@map("workflow_actions")
}

model WorkflowLog {
  id          String   @id @default(cuid())
  status      String   
  errorMsg    String?  @db.Text
  context     Json?    
  
  workflowId  String   @map("workflow_id")
  workflow    Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([workflowId, createdAt(sort: Desc)])
  @@map("workflow_logs")
}
